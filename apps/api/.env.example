# ===========================================
# Fyde Jarvis – API (cérebro)
# Copie para .env e preencha os valores
# cp .env.example .env
# ===========================================

# Nome da aplicação
APP_NAME=Fyde Jarvis

# Neon Postgres (obrigatório)
# Exemplo: postgresql+psycopg2://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# OpenRouter (obrigatório por enquanto)
# Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Chave secreta da aplicação (gere uma string longa e aleatória)
SECRET_KEY=troque-por-uma-string-bem-longa-e-aleatoria

# Firebase Service Account (JSON em uma linha)
# Só necessário se for usar autenticação real (/agent/chat)
# Deixe um JSON vazio {} se for só usar /chat-test
FIREBASE_CREDENTIALS={}

# --- LLM (opcional) ---
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-3-haiku
# Alternativas futuras: groq, ollama, etc.
