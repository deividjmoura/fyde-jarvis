# ===========================================
# Fyde Jarvis – API (cérebro)
# Copie para .env e preencha os valores:
#   cp .env.example .env
# ===========================================

# Nome da aplicação
APP_NAME=Fyde Jarvis

# Banco Postgres (obrigatório)
# Opção 1 — Neon (nuvem, gratuito): copie a connection string do dashboard
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Opção 2 — Docker local: rode `docker compose up -d` na raiz do repo e use:
# DATABASE_URL=postgresql+psycopg2://fydeuser:fydepass@localhost:5432/fydejarvis?sslmode=disable

# OpenRouter (obrigatório por enquanto)
# Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Chave secreta da aplicação (gere uma string longa e aleatória)
SECRET_KEY=troque-por-uma-string-bem-longa-e-aleatoria

# Firebase Service Account (JSON em uma linha)
# Só necessário se for usar autenticação real (/agent/chat)
# Deixe um JSON vazio {} se for usar apenas /chat-test
FIREBASE_CREDENTIALS={}

# Origens permitidas no CORS (separadas por vírgula)
# Em produção, coloque a URL do frontend (Netlify) aqui
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM (opcional) ---
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-3-haiku

# --- Modo OFFLINE com Ollama (opcional) ---
# Instale em https://ollama.com e rode: ollama serve && ollama pull llama3.1
# Se OPENROUTER_API_KEY estiver ausente, a API usa Ollama automaticamente.
# Para forçar modo 100% local: LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ===========================================
# Tools do agente — TUDO OPCIONAL (já tem padrão)
# ===========================================

# Fuso usado pela tool de data/hora. A API roda em UTC na nuvem, então o
# padrão é o fuso do usuário e não o relógio do servidor.
# JARVIS_TIMEZONE=America/Sao_Paulo

# Clima — Open-Meteo, NÃO exige API key. Nada a configurar.
# WEATHER_TIMEOUT_SECONDS=10

# Busca web:
#   wikipedia (padrão) → Wikipédia em português, sem API key
#   tavily             → busca web real, exige TAVILY_API_KEY (https://tavily.com)
# WEB_SEARCH_PROVIDER=wikipedia
# WEB_SEARCH_MAX_RESULTS=3
# WEB_SEARCH_TIMEOUT_SECONDS=10

# ---------- GitHub (opcional, mas recomendado) ----------
# PAT em github.com/settings/tokens — sobe o rate limit de 60 → 5.000 req/h
# e permite analisar repositórios PRIVADOS. Vazio = só públicos.
# GITHUB_TOKEN=
# GITHUB_TIMEOUT_SECONDS=15
# TAVILY_API_KEY=

# User-Agent enviado a APIs públicas (a Wikipédia pede um identificável).
# HTTP_USER_AGENT=FydeJarvis/1.0 (https://github.com/deividjmoura/fyde-jarvis)

